# Copy to .env for local work. Never commit .env.

# Postgres connection string. Locally, `npm run db:local` prints a working value.
# On Render, use the Internal Database URL of your Postgres service.
DATABASE_URL=postgres://postgres:postgres@localhost:54330/carecloud

# Shared secret Vapi sends in the X-Vapi-Secret header on every webhook.
# Any long random string. Must match on the server and when running vapi:sync.
VAPI_WEBHOOK_SECRET=

# Port the server listens on. Set to 10000 on Render.
PORT=3000

# Only needed by `npm run vapi:sync`, which creates the assistant and number.
# Private API key from the Vapi dashboard.
VAPI_API_KEY=
# Public HTTPS base URL of this app, for example https://your-app.onrender.com
PUBLIC_BASE_URL=
